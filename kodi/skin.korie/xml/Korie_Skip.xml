<?xml version="1.0" encoding="UTF-8"?>
<!-- Korie: "Skip intro" over a playing episode, bottom right, while its intro plays. The Korie
     add-on opens and closes it; OK skips, Back hides it and the episode goes on. -->
<window>
	<defaultcontrol always="true">10</defaultcontrol>
	<zorder>1</zorder>
	<animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
	<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
	<controls>
		<control type="button" id="10">
			<right>80</right><bottom>110</bottom><width>280</width><height>84</height>
			<align>center</align><aligny>center</aligny>
			<font>korie_heading30</font><textcolor>korie_ink</textcolor><focusedcolor>korie_onaccent</focusedcolor>
			<texturefocus border="42,0,42,0" colordiffuse="korie_accent">korie/pill84.png</texturefocus>
			<texturenofocus border="42,0,42,0" colordiffuse="korie_shade90">korie/pill84.png</texturenofocus>
			<label>Skip intro</label>
		</control>
	</controls>
</window>
