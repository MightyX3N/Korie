<?xml version="1.0" encoding="UTF-8"?>
<!-- Korie: the buttons of Now playing (OK on it): shuffle, back, play or pause, on, repeat. Drawn
     where MusicVisualisation.xml shows them, with the focus. -->
<window>
	<defaultcontrol always="true">703</defaultcontrol>
	<depth>DepthOSD</depth>
	<controls>
		<control type="button">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texturefocus /><texturenofocus />
			<label />
			<onclick>Action(close)</onclick>
		</control>
		<control type="button" id="701">
			<left>728</left><top>580</top><width>64</width><height>64</height>
			<onleft>noop</onleft><onright>702</onright><onup>noop</onup><ondown>noop</ondown>
			<texturefocus /><texturenofocus />
			<label />
			<onclick>PlayerControl(Random)</onclick>
		</control>
		<control type="image">
			<left>728</left><top>580</top><width>64</width><height>64</height>
			<texture colordiffuse="korie_accent">korie/mask-circle.png</texture>
			<visible>Control.HasFocus(701)</visible>
		</control>
		<control type="image">
			<left>744</left><top>596</top><width>32</width><height>32</height>
			<texture colordiffuse="korie_onaccent">korie/icon-shuffle.png</texture>
