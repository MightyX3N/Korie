<?xml version="1.0" encoding="UTF-8"?>
<!-- Korie: Now playing - Kodi's music full screen. The album, what's playing, how far in, the
     buttons and what's up next. OK brings the buttons to life (MusicOSD.xml); Back goes back to
     the menus while it keeps playing. -->
<window>
	<defaultcontrol />
	<backgroundcolor>background</backgroundcolor>
	<controls>
		<include>KorieBackground</include>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<aspectratio>scale</aspectratio>
			<colordiffuse>33FFFFFF</colordiffuse>
			<texture background="true">$INFO[Player.Art(fanart)]</texture>
		</control>
		<control type="group">
			<left>96</left><top>52</top>
			<control type="image">
				<left>0</left><top>16</top><width>28</width><height>28</height>
				<texture colordiffuse="korie_soft">korie/icon-back.png</texture>
			</control>
			<control type="label">
				<left>40</left><top>0</top><width>600</width><height>60</height>
				<aligny>center</aligny>
				<font>korie_body28</font><textcolor>korie_soft</textcolor>
				<label>Music</label>
			</control>
		</control>
		<include content="KorieClock"/>

		<!-- the album -->
		<control type="image">
			<left>96</left><top>170</top><width>560</width><height>560</height>
			<texture border="16" colordiffuse="korie_panel">korie/r16.png</texture>
		</control>
		<control type="image">
			<left>296</left><top>370</top><width>160</width><height>160</height>
			<texture colordiffuse="korie_dim">korie/icon-music.png</texture>
			<visible>String.Contains(MusicPlayer.Cover,DefaultAlbumCover) | String.IsEmpty(MusicPlayer.Cover)</visible>
		</control>
		<control type="image">
			<left>96</left><top>170</top><width>560</width><height>560</height>
			<aspectratio>scale</aspectratio>
			<texture diffuse="korie/mask-square.png" background="true">$INFO[MusicPlayer.Cover]</texture>
			<visible>!String.Contains(MusicPlayer.Cover,DefaultAlbumCover)</visible>
		</control>

		<!-- what's playing -->
		<control type="label">
			<left>728</left><top>206</top><width>620</width><height>40</height>
			<font>korie_body26</font><textcolor>korie_dim</textcolor>
			<label>Now playing$INFO[Playlist.Position, · track ]$INFO[Playlist.Length, of ]</label>
		</control>
		<control type="label">
			<left>728</left><top>250</top><width>640</width><height>100</height>
			<font>korie_heading72</font><textcolor>korie_ink</textcolor>
			<scroll>true</scroll>
			<label>$INFO[MusicPlayer.Title]</label>
		</control>
		<control type="label">
			<left>728</left><top>350</top><width>620</width><height>52</height>
			<font>korie_body36</font><textcolor>korie_ink</textcolor>
			<label>$INFO[MusicPlayer.Artist]</label>
		</control>
		<control type="label">
			<left>728</left><top>408</top><width>620</width><height>40</height>
			<font>korie_body28</font><textcolor>korie_soft</textcolor>
			<label>$INFO[MusicPlayer.Album]$INFO[MusicPlayer.Year, · ]</label>
		</control>

		<!-- how far in -->
		<control type="progress">
			<left>728</left><top>490</top><width>620</width><height>8</height>
			<info>Player.Progress</info>
			<texturebg border="4" colordiffuse="korie_ink25">korie/r10.png</texturebg>
			<midtexture border="4" colordiffuse="korie_accent">korie/r10.png</midtexture>
		</control>
		<control type="label">
			<left>728</left><top>508</top><width>300</width><height>34</height>
			<font>korie_body24</font><textcolor>korie_soft</textcolor>
			<label>$INFO[Player.Time]</label>
		</control>
		<control type="label">
			<left>1048</left><top>508</top><width>300</width><height>34</height>
			<align>right</align>
			<font>korie_body24</font><textcolor>korie_soft</textcolor>
			<label>$INFO[Player.Duration]</label>
		</control>

		<!-- the buttons (OK for them: MusicOSD.xml) -->
		<control type="image">
			<left>744</left><top>596</top><width>32</width><height>32</height>
			<texture colordiffuse="korie_accent">korie/icon-shuffle.png</texture>
			<visible>Playlist.IsRandom</visible>
		</control>
		<control type="image">
			<left>744</left><top>596</top><width>32</width><height>32</height>
			<texture colordiffuse="korie_soft">korie/icon-shuffle.png</texture>
			<visible>!Playlist.IsRandom</visible>
		</control>
		<control type="image">
			<left>814</left><top>572</top><width>80</width><height>80</height>
			<texture colordiffuse="korie_panel">korie/mask-circle.png</texture>
		</control>
		<control type="image">
			<left>837</left><top>595</top><width>34</width><height>34</height>
			<texture colordiffuse="korie_ink">korie/icon-prev.png</texture>
			
		</control>
		<control type="image">
			<left>916</left><top>560</top><width>104</width><height>104</height>
			<texture colordiffuse="korie_accent">korie/mask-circle.png</texture>
		</control>
		<control type="image">
			<left>946</left><top>590</top><width>44</width><height>44</height>
			<texture colordiffuse="korie_onaccent">$VAR[KoriePlayPauseIcon]</texture>
		</control>
		<control type="image">
			<left>1042</left><top>572</top><width>80</width><height>80</height>
			<texture colordiffuse="korie_panel">korie/mask-circle.png</texture>
		</control>
		<control type="image">
			<left>1065</left><top>595</top><width>34</width><height>34</height>
			<texture colordiffuse="korie_ink">korie/icon-next.png</texture>
			
		</control>
		<control type="image">
			<left>1160</left><top>596</top><width>32</width><height>32</height>
			<texture colordiffuse="korie_accent">korie/icon-repeat.png</texture>
			<visible>[Playlist.IsRepeat | Playlist.IsRepeatOne]</visible>
		</control>
		<control type="image">
			<left>1160</left><top>596</top><width>32</width><height>32</height>
			<texture colordiffuse="korie_soft">korie/icon-repeat.png</texture>
			<visible>![Playlist.IsRepeat | Playlist.IsRepeatOne]</visible>
		</control>
		<control type="label">
			<left>728</left><top>676</top><width>620</width><height>34</height>
			<font>korie_body22</font><textcolor>korie_dim</textcolor>
			<label>OK for the buttons · Back for the menus</label>
		</control>

		<!-- up next -->
		<control type="label">
			<left>1394</left><top>168</top><width>430</width><height>44</height>
			<font>korie_heading34</font><textcolor>korie_soft</textcolor>
			<label>Up next</label>
		</control>
		<control type="group">
			<left>1394</left><top>222</top>
			<visible>!String.IsEmpty(MusicPlayer.offset(0).Title)</visible>
			<control type="image"><width>430</width><height>57</height><texture border="12" colordiffuse="korie_panel">korie/r12.png</texture></control>
			<control type="label">
				<left>18</left><width>320</width><height>57</height><aligny>center</aligny>
				<font>korie_heading30</font><textcolor>korie_ink</textcolor>
				<label>$INFO[MusicPlayer.offset(0).TrackNumber,,. ]$INFO[MusicPlayer.offset(0).Title]</label>
			</control>
			<control type="label">
				<left>320</left><width>92</width><height>57</height><align>right</align><aligny>center</aligny>
				<font>korie_body24</font><textcolor>korie_dim</textcolor>
				<label>$INFO[MusicPlayer.offset(0).Duration]</label>
			</control>
		</control>
		<control type="group">
			<left>1394</left><top>285</top>
			<visible>!String.IsEmpty(MusicPlayer.offset(1).Title)</visible>
			
			<control type="label">
				<left>18</left><width>320</width><height>57</height><aligny>center</aligny>
				<font>korie_body26</font><textcolor>korie_soft</textcolor>
				<label>$INFO[MusicPlayer.offset(1).TrackNumber,,. ]$INFO[MusicPlayer.offset(1).Title]</label>
			</control>
			<control type="label">
				<left>320</left><width>92</width><height>57</height><align>right</align><aligny>center</aligny>
				<font>korie_body24</font><textcolor>korie_dim</textcolor>
				<label>$INFO[MusicPlayer.offset(1).Duration]</label>
			</control>
		</control>
		<control type="group">
			<left>1394</left><top>348</top>
			<visible>!String.IsEmpty(MusicPlayer.offset(2).Title)</visible>
			
			<control type="label">
				<left>18</left><width>320</width><height>57</height><aligny>center</aligny>
				<font>korie_body26</font><textcolor>korie_soft</textcolor>
				<label>$INFO[MusicPlayer.offset(2).TrackNumber,,. ]$INFO[MusicPlayer.offset(2).Title]</label>
			</control>
			<control type="label">
				<left>320</left><width>92</width><height>57</height><align>right</align><aligny>center</aligny>
				<font>korie_body24</font><textcolor>korie_dim</textcolor>
				<label>$INFO[MusicPlayer.offset(2).Duration]</label>
			</control>
		</control>
		<control type="group">
			<left>1394</left><top>411</top>
			<visible>!String.IsEmpty(MusicPlayer.offset(3).Title)</visible>
			
			<control type="label">
				<left>18</left><width>320</width><height>57</height><aligny>center</aligny>
				<font>korie_body26</font><textcolor>korie_soft</textcolor>
				<label>$INFO[MusicPlayer.offset(3).TrackNumber,,. ]$INFO[MusicPlayer.offset(3).Title]</label>
			</control>
			<control type="label">
				<left>320</left><width>92</width><height>57</height><align>right</align><aligny>center</aligny>
				<font>korie_body24</font><textcolor>korie_dim</textcolor>
				<label>$INFO[MusicPlayer.offset(3).Duration]</label>
			</control>
		</control>
		<control type="group">
			<left>1394</left><top>474</top>
			<visible>!String.IsEmpty(MusicPlayer.offset(4).Title)</visible>
			
			<control type="label">
				<left>18</left><width>320</width><height>57</height><aligny>center</aligny>
				<font>korie_body26</font><textcolor>korie_soft</textcolor>
				<label>$INFO[MusicPlayer.offset(4).TrackNumber,,. ]$INFO[MusicPlayer.offset(4).Title]</label>
			</control>
			<control type="label">
				<left>320</left><width>92</width><height>57</height><align>right</align><aligny>center</aligny>
				<font>korie_body24</font><textcolor>korie_dim</textcolor>
				<label>$INFO[MusicPlayer.offset(4).Duration]</label>
			</control>
		</control>
		<control type="group">
			<left>1394</left><top>537</top>
			<visible>!String.IsEmpty(MusicPlayer.offset(5).Title)</visible>
			
			<control type="label">
				<left>18</left><width>320</width><height>57</height><aligny>center</aligny>
				<font>korie_body26</font><textcolor>korie_soft</textcolor>
				<label>$INFO[MusicPlayer.offset(5).TrackNumber,,. ]$INFO[MusicPlayer.offset(5).Title]</label>
			</control>
			<control type="label">
				<left>320</left><width>92</width><height>57</height><align>right</align><aligny>center</aligny>
				<font>korie_body24</font><textcolor>korie_dim</textcolor>
				<label>$INFO[MusicPlayer.offset(5).Duration]</label>
			</control>
		</control>
	</controls>
</window>
