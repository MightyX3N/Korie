<?xml version="1.0" encoding="utf-8"?>
<!-- Korie: while a DVD shows its own menu. A bar at the top says where you are, and one at the
     bottom says what the keys do: the arrows and OK go to the disc's menu, Menu opens Korie's
     controls (VideoOSD.xml, with "Disc menu" and "Skip the menu, play the film"). Nothing here
     takes focus, so every key still reaches the disc. -->
<window type="dialog" id="1112">
	<visible>Window.IsActive(fullscreenvideo) + $EXP[KorieInDiscMenu] + !Window.IsActive(videoosd) + !Window.IsActive(videobookmarks) + !Window.IsActive(osdvideosettings)</visible>
	<depth>DepthOSD</depth>
	<zorder>0</zorder>
	<animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
	<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
	<controls>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>96</height>
			<texture colordiffuse="korie_ground">korie/mask-square.png</texture>
		</control>
		<control type="image">
			<left>66</left><top>30</top><width>36</width><height>36</height>
			<texture colordiffuse="korie_accent">korie/icon-disc.png</texture>
		</control>
		<control type="grouplist">
			<left>120</left><top>0</top><width>1300</width><height>96</height>
			<orientation>horizontal</orientation><itemgap>22</itemgap>
			<control type="label">
				<width>auto</width><height>96</height><aligny>center</aligny>
				<font>korie_heading34</font><textcolor>korie_ink</textcolor>
				<label>$INFO[VideoPlayer.Title]</label>
			</control>
			<control type="label">
				<width>auto</width><height>96</height><aligny>center</aligny>
				<font>korie_body26</font><textcolor>korie_soft</textcolor>
				<label>DVD · in the disc's menu</label>
			</control>
		</control>
		<control type="label">
			<right>64</right><top>0</top><width>300</width><height>96</height>
			<align>right</align><aligny>center</aligny>
			<font>korie_heading34</font><textcolor>korie_ink</textcolor>
			<label>$INFO[System.Time]</label>
		</control>

		<!-- what the keys do -->
		<control type="group">
			<left>440</left><top>974</top><width>1040</width><height>58</height>
			<control type="image">
				<width>1040</width><height>58</height>
				<texture border="29,0,29,0" colordiffuse="korie_panel">korie/pill72.png</texture>
			</control>
			<control type="label">
				<left>0</left><width>1040</width><height>58</height>
				<align>center</align><aligny>center</aligny>
				<font>korie_body24</font><textcolor>korie_soft</textcolor>
				<label>[COLOR korie_ink][B]Arrows[/B][/COLOR]: move in the disc's menu      [COLOR korie_ink][B]OK[/B][/COLOR]: choose      [COLOR korie_ink][B]Menu[/B][/COLOR]: Korie's controls</label>
			</control>
		</control>
	</controls>
</window>
