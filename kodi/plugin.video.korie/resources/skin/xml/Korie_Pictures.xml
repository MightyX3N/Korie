<?xml version="1.0" encoding="UTF-8"?>
<!-- Korie: pick a picture (another poster for a film or series). The Korie add-on fills panel 100. -->
<window>
	<defaultcontrol always="true">100</defaultcontrol>
	<depth>DepthDialog</depth>
	<controls>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="korie_shade90">colors/white.png</texture>
			<animation effect="fade" start="0" end="100" time="150">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
		</control>
		<control type="group">
			<left>160</left><top>90</top>
			<animation effect="fade" start="0" end="100" time="150">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
			<control type="image">
				<width>1600</width><height>900</height>
				<texture border="22" colordiffuse="korie_panel2">korie/r28.png</texture>
			</control>
			<control type="label">
				<left>48</left><top>32</top><width>1100</width><height>64</height>
				<aligny>center</aligny>
				<font>korie_heading40</font><textcolor>korie_ink</textcolor>
				<label>$INFO[Window.Property(korie.title)]</label>
			</control>
			<control type="label">
				<left>1152</left><top>32</top><width>400</width><height>64</height>
				<align>right</align><aligny>center</aligny>
				<font>korie_body24</font><textcolor>korie_dim</textcolor>
				<label>$INFO[Container(100).CurrentItem]$INFO[Container(100).NumItems, of ,]</label>
			</control>
			<control type="panel" id="100">
				<left>36</left><top>116</top><width>1536</width><height>768</height>
				<orientation>vertical</orientation>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<itemlayout width="256" height="384">
					<include content="KoriePictureCard"><param name="focus">false</param></include>
				</itemlayout>
				<focusedlayout width="256" height="384">
					<include content="KoriePictureCard"><param name="focus">Control.HasFocus(100)</param></include>
				</focusedlayout>
			</control>
		</control>
	</controls>
</window>
