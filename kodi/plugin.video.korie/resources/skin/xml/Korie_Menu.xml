<?xml version="1.0" encoding="UTF-8"?>
<!-- Korie: a menu over the screen - the options for a film (the remote's Menu button), or a list
     to choose from (themes, the right film for "Fix details"). The Korie add-on fills list 100
     and sizes the panel (90) to it. -->
<window>
	<defaultcontrol always="true">100</defaultcontrol>
	<depth>DepthDialog</depth>
	<controls>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="korie_shade60">colors/white.png</texture>
			<animation effect="fade" start="0" end="100" time="150">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
		</control>
		<control type="group" id="80">
			<left>670</left><top>200</top>
			<animation effect="fade" start="0" end="100" time="150">WindowOpen</animation>
			<animation effect="zoom" start="96" end="100" center="auto" time="150" tween="cubic" easing="out">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
			<control type="image" id="90">
				<left>0</left><top>0</top><width>580</width><height>600</height>
				<texture border="22" colordiffuse="korie_panel">korie/r28.png</texture>
			</control>
			<control type="label">
				<left>36</left><top>30</top><width>508</width><height>60</height>
				<aligny>center</aligny>
				<font>korie_heading34</font><textcolor>korie_ink</textcolor>
				<label>$INFO[Window.Property(korie.title)]</label>
			</control>
			<control type="list" id="100">
				<left>12</left><top>102</top><width>556</width><height>630</height>
				<orientation>vertical</orientation>
				<scrolltime tween="cubic" easing="out">150</scrolltime>
				<onleft>noop</onleft><onright>noop</onright>
				<itemlayout width="556" height="63">
					<include content="KorieMenuRow"><param name="focus">false</param></include>
				</itemlayout>
				<focusedlayout width="556" height="63">
					<include content="KorieMenuRow"><param name="focus">Control.HasFocus(100)</param></include>
				</focusedlayout>
			</control>
		</control>
	</controls>
</window>
