<?xml version="1.0" encoding="UTF-8"?>
<timers>
    <timer>
        <name>autoclosevideoosd</name>
        <description>Timer to auto close the video OSD (if enabled in the skin settings)</description>
        <start reset="true">Window.IsActive(videoosd) + Skin.HasSetting(OSDAutoClose) + !String.IsEqual(window(home).Property(settingslist_content),osd) + !Window.IsActive(osdsubtitlesettings) + !Window.IsActive(osdaudiosettings) + !Window.IsActive(osdvideosettings) + !Window.IsActive(OSDCMSSettings)</start>
        <reset>Window.IsActive(videoosd) + !System.IdleTime(1) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(autoclosevideoosd), 1) | String.IsEqual(window(home).Property(settingslist_content),osd) | Window.IsActive(osdsubtitlesettings) | Window.IsActive(osdaudiosettings) | Window.IsActive(osdvideosettings) | Window.IsActive(OSDCMSSettings)</reset>
        <stop>!Window.IsActive(videoosd) | String.IsEmpty(Skin.String(OSDAutoCloseTime)) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(autoclosevideoosd), 4) | !String.IsEmpty(Skin.String(OSDAutoCloseTime)) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(autoclosevideoosd),Skin.Numeric(OSDAutoCloseTime))</stop>
        <onstop>Dialog.Close(videoosd)</onstop>
    </timer>
    <timer>
        <name>1109_topbaroverlay</name>
        <description>A timer that is activated when the topbaroverlay is loaded and stops automatically after 5 seconds (or playback is resumed)</description>
        <start reset="true">[Window.IsActive(videoosd) | Window.IsActive(musicosd) | Window.IsActive(playerprocessinfo)] | [Window.IsActive(1109) + [Player.Seeking | Player.Forwarding | Player.Rewinding | Player.HasPerformedSeek(1)]]</start>
        <reset>Player.Seeking | Player.Forwarding | Player.Rewinding | Player.HasPerformedSeek(1)</reset>
        <stop>Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(1109_topbaroverlay),5) | Player.Playing</stop>
    </timer>
    <timer>
        <name>korie_chapters_focus</name>
        <description>Korie: focus the chapter list once Kodi has filled it</description>
        <start reset="true">Window.IsActive(videobookmarks) + !Control.HasFocus(11) + Integer.IsGreater(Container(11).NumItems,0)</start>
        <stop>Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(korie_chapters_focus),0)</stop>
        <onstop>SetFocus(11)</onstop>
    </timer>
    <timer>
        <name>korie_rows_steady</name>
        <description>Korie: after switching person, Home's rows hide while they load; once none is loading, they show while refreshing again</description>
        <start reset="true">Window.IsActive(home) + String.IsEmpty(Window(Home).Property(korie.steady))</start>
        <stop>Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(korie_rows_steady),2) + [!String.IsEqual(Window(Home).Property(korie.row.1.kind),wide) | !Container(511).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.1.kind),poster) | !Container(512).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.1.kind),square) | !Container(513).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.2.kind),wide) | !Container(521).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.2.kind),poster) | !Container(522).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.2.kind),square) | !Container(523).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.3.kind),wide) | !Container(531).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.3.kind),poster) | !Container(532).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.3.kind),square) | !Container(533).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.4.kind),wide) | !Container(541).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.4.kind),poster) | !Container(542).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.4.kind),square) | !Container(543).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.5.kind),wide) | !Container(551).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.5.kind),poster) | !Container(552).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.5.kind),square) | !Container(553).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.6.kind),wide) | !Container(561).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.6.kind),poster) | !Container(562).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.6.kind),square) | !Container(563).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.7.kind),wide) | !Container(571).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.7.kind),poster) | !Container(572).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.7.kind),square) | !Container(573).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.8.kind),wide) | !Container(581).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.8.kind),poster) | !Container(582).IsUpdating] + [!String.IsEqual(Window(Home).Property(korie.row.8.kind),square) | !Container(583).IsUpdating]</stop>
        <onstop>SetProperty(korie.steady,1,home)</onstop>
    </timer>
</timers>
