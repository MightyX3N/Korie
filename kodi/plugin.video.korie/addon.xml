<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.korie" name="Korie" version="{VERSION}" provider-name="Korie">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>video audio</provides>
  </extension>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Your Korie server in Kodi</summary>
    <description lang="en_GB">Films, series, music, live TV and add-ons from the Korie server on your network, with your profile, played by Kodi.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <source>https://github.com/MightyX3N/Korie</source>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
