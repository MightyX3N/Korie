<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- {BASE} is filled in by the Korie server with its own address, so Kodi updates from that server.
     The repository lives in repo/, apart from the page Kodi browses for "Install from zip file":
     Kodi remembers what that page lists and would otherwise think the repository files are missing. -->
<addon id="repository.korie" name="Korie" version="{VERSION}" provider-name="Korie">
  <extension point="xbmc.addon.repository" name="Korie">
    <dir>
      <info compressed="false">{BASE}repo/addons.xml</info>
      <checksum>{BASE}repo/addons.xml.md5</checksum>
      <datadir zip="true">{BASE}repo/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Korie, from your Korie server</summary>
    <description lang="en_GB">Installs and updates the Korie add-on and skin from the Korie server on your network.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <assets><icon>icon.png</icon></assets>
  </extension>
</addon>
