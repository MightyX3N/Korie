<?xml version="1.0" encoding="UTF-8"?>
<!-- Korie: every list of things from the server (Films, Series, a series' seasons and episodes,
     Live TV, add-ons, search results). Posters in a grid, or a list with pictures and text. -->
<window>
	<defaultcontrol always="true">5100</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<views>50,51,52,53,54,55</views>
	<menucontrol>9000</menucontrol>
	<controls>
		<include>KorieBackground</include>
		<control type="group">
			<visible>Control.IsVisible(51) | Container.Content(seasons)</visible>
			<include content="KorieBackdrop"><param name="art">$INFO[Container.ListItem.Art(fanart)]</param></include>
		</control>
		<control type="group">
			<visible>String.IsEmpty(Container.Property(korie.series))</visible>
			<include content="KorieRail"><param name="right">5100</param></include>
			<include content="KorieHeader">
				<param name="title">$VAR[KorieListTitle]</param>
				<param name="note">$VAR[KorieListCount]</param>
			</include>
		</control>

		<!-- a series' page: what it is on the left (as the film page), seasons and episodes on the right -->
		<control type="group">
			<visible>!String.IsEmpty(Container.Property(korie.series))</visible>
			<control type="image">
				<left>0</left><top>0</top><width>1920</width><height>1080</height>
				<texture colordiffuse="korie_shade90">colors/white.png</texture>
			</control>
			<control type="group">
				<left>96</left><top>52</top>
				<control type="image">
					<left>0</left><top>16</top><width>28</width><height>28</height>
					<texture colordiffuse="korie_soft">korie/icon-back.png</texture>
				</control>
				<control type="label">
					<left>40</left><top>0</top><width>600</width><height>60</height>
					<aligny>center</aligny>
					<font>korie_body26</font><textcolor>korie_soft</textcolor>
					<label>Series</label>
				</control>
			</control>
			<include content="KorieClock"><param name="date">false</param></include>
			<control type="image">
				<left>96</left><top>140</top><width>220</width><height>330</height>
				<texture border="12" colordiffuse="korie_panel">korie/r10.png</texture>
			</control>
			<control type="image">
				<left>96</left><top>140</top><width>220</width><height>330</height>
				<aspectratio>scale</aspectratio>
				<texture diffuse="korie/mask-poster.png" background="true">$INFO[Container.Property(korie.series.poster)]</texture>
			</control>
			<control type="label">
				<left>96</left><top>494</top><width>620</width><height>96</height>
				<font>korie_heading72</font><textcolor>korie_ink</textcolor>
				<label>$INFO[Container.Property(korie.series.title)]</label>
			</control>
			<control type="label">
				<left>96</left><top>592</top><width>620</width><height>36</height>
				<font>korie_body26</font><textcolor>korie_soft</textcolor>
				<label>$INFO[Container.Property(korie.series.meta)]</label>
			</control>
			<control type="label">
				<left>96</left><top>630</top><width>620</width><height>36</height>
				<font>korie_body26</font><textcolor>korie_soft</textcolor>
				<label>$INFO[Container.Property(korie.series.genres)]</label>
			</control>
			<control type="textbox">
				<left>96</left><top>682</top><width>600</width><height>150</height>
				<font>korie_body28</font><textcolor>korie_soft</textcolor>
				<label>$INFO[Container.Property(korie.series.plot)]</label>
				<autoscroll delay="8000" time="2500" repeat="8000">true</autoscroll>
			</control>
			<control type="button" id="610">
				<left>96</left><top>860</top><width>360</width><height>84</height>
				<align>center</align><aligny>center</aligny>
				<font>korie_body28</font>
				<textcolor>korie_ink</textcolor>
				<focusedcolor>korie_onaccent</focusedcolor>
				<texturefocus border="42,0,42,0" colordiffuse="korie_accent">korie/pill84.png</texturefocus>
				<texturenofocus border="42,0,42,0" colordiffuse="korie_panel">korie/pill84.png</texturenofocus>
				<label>$INFO[Container.Property(korie.series.button)]</label>
				<onclick>PlayMedia($INFO[Container.Property(korie.series.play)])</onclick>
				<onright>5100</onright>
				<onup condition="!String.IsEmpty(Container.Property(korie.tab1.label))">SetFocus(600,$INFO[Container.Property(korie.tabon)],absolute)</onup>
				<visible>!String.IsEmpty(Container.Property(korie.series.play))</visible>
			</control>
			<control type="label">
				<right>64</right><top>146</top><width>400</width><height>56</height>
				<align>right</align><aligny>center</aligny>
				<font>korie_body24</font><textcolor>korie_dim</textcolor>
				<label>$INFO[Container.Property(korie.series.count)]</label>
			</control>
		</control>

		<control type="label">
			<left>444</left><top>220</top><width>1300</width><height>120</height>
			<font>korie_body28</font><textcolor>korie_dim</textcolor>
			<wrapmultiline>true</wrapmultiline>
			<label>$VAR[KorieListEmpty]</label>
			<visible>Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating</visible>
		</control>

		<control type="group" id="5100">
			<animation effect="slide" start="0,0" end="0,84" time="0" condition="!String.IsEmpty(Container.Property(korie.tab1.label))">Conditional</animation>
			<!-- nothing in the list: Kodi still puts its ".." in it. Out of sight (hidden, nothing could
			     have the focus and the remote would do nothing); the note above says why it's empty -->
			<animation effect="slide" start="0,0" end="0,2400" time="0" condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">Conditional</animation>
			<!-- 50: posters (films, series, seasons, albums) -->
			<control type="panel" id="50">
				<left>444</left><top>152</top><width>1456</width><height>800</height>
				<onleft>$VAR[KorieToMenu]</onleft>
				<onup condition="!String.IsEmpty(Container.Property(korie.tab1.label))">SetFocus(600,$INFO[Container.Property(korie.tabon)],absolute)</onup>
				<onup condition="String.IsEmpty(Container.Property(korie.tab1.label))">9000</onup>
				<ondown condition="Player.HasAudio">700</ondown>
				<orientation>vertical</orientation>
				<scrolltime tween="cubic" easing="out">240</scrolltime>
				<preloaditems>2</preloaditems>
				<visible>Container.Content(movies) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(sets)</visible>
				<itemlayout width="206" height="340">
					<control type="group">
						<left>14</left><top>14</top>
						<include content="KorieCardPoster"/>
					</control>
					<control type="label">
						<left>14</left><top>284</top><width>172</width><height>34</height>
						<font>korie_body22</font><textcolor>korie_soft</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</itemlayout>
				<focusedlayout width="206" height="340">
					<control type="group">
						<left>14</left><top>14</top>
						<include content="KorieCardPoster"><param name="focus">Control.HasFocus(50)</param></include>
					</control>
					<control type="label">
						<left>14</left><top>284</top><width>172</width><height>34</height>
						<font>korie_body22</font><textcolor>korie_ink</textcolor>
						<scroll>true</scroll>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</focusedlayout>
			</control>

			<!-- 52: albums and artists, square -->
			<control type="panel" id="52">
				<left>444</left><top>152</top><width>1476</width><height>800</height>
				<onleft>$VAR[KorieToMenu]</onleft>
				<onup condition="!String.IsEmpty(Container.Property(korie.tab1.label))">SetFocus(600,$INFO[Container.Property(korie.tabon)],absolute)</onup>
				<onup condition="String.IsEmpty(Container.Property(korie.tab1.label))">9000</onup>
				<ondown condition="Player.HasAudio">700</ondown>
				<orientation>vertical</orientation>
				<scrolltime tween="cubic" easing="out">240</scrolltime>
				<visible>Container.Content(albums) | Container.Content(artists)</visible>
				<itemlayout width="246" height="310">
					<control type="group"><left>14</left><top>14</top><include content="KorieAlbumCard"/></control>
				</itemlayout>
				<focusedlayout width="246" height="310">
					<control type="group"><left>14</left><top>14</top><include content="KorieAlbumCard"><param name="focus">Control.HasFocus(52)</param></include></control>
				</focusedlayout>
			</control>

			<!-- 53: songs -->
			<control type="list" id="53">
				<left>444</left><top>152</top><width>1412</width><height>800</height>
				<onleft>$VAR[KorieToMenu]</onleft>
				<onup condition="!String.IsEmpty(Container.Property(korie.tab1.label))">SetFocus(600,$INFO[Container.Property(korie.tabon)],absolute)</onup>
				<onup condition="String.IsEmpty(Container.Property(korie.tab1.label))">9000</onup>
				<ondown condition="Player.HasAudio">700</ondown>
				<orientation>vertical</orientation>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<visible>Container.Content(songs)</visible>
				<itemlayout width="1412" height="76">
					<include content="KorieSongRow"><param name="focus">false</param></include>
				</itemlayout>
				<focusedlayout width="1412" height="76">
					<include content="KorieSongRow"><param name="focus">Control.HasFocus(53)</param></include>
				</focusedlayout>
			</control>

			<!-- 51: a list with pictures and text (episodes, live channels, add-ons, rows, search results) -->
			<control type="list" id="51">
				<left>444</left><top>152</top><width>1412</width><height>928</height>
				<!-- on a series' page: narrower, beside what the series is (left goes to its Play button) -->
				<animation effect="slide" start="0,0" end="336,-12" time="0" condition="!String.IsEmpty(Container.Property(korie.series))">Conditional</animation>
				<onleft condition="String.IsEmpty(Container.Property(korie.series))">$VAR[KorieToMenu]</onleft>
				<onleft condition="!String.IsEmpty(Container.Property(korie.series))">610</onleft>
				<onup condition="!String.IsEmpty(Container.Property(korie.tab1.label))">SetFocus(600,$INFO[Container.Property(korie.tabon)],absolute)</onup>
				<onup condition="String.IsEmpty(Container.Property(korie.tab1.label))">9000</onup>
				<ondown condition="Player.HasAudio">700</ondown>
				<orientation>vertical</orientation>
				<scrolltime tween="cubic" easing="out">220</scrolltime>
				<visible>!Container.Content(movies) + !Container.Content(tvshows) + !Container.Content(seasons) + !Container.Content(albums) + !Container.Content(artists) + !Container.Content(songs) + !Container.Content(sets) + !String.IsEqual(Container.Property(korie.section),apps) + !String.IsEqual(Container.Property(korie.section),addons)</visible>
				<itemlayout width="1044" height="148" condition="!String.IsEmpty(Container.Property(korie.series))">
					<include content="KorieEpisodeRow"><param name="focus">false</param></include>
				</itemlayout>
				<focusedlayout width="1044" height="148" condition="!String.IsEmpty(Container.Property(korie.series))">
					<include content="KorieEpisodeRow"><param name="focus">Control.HasFocus(51)</param></include>
				</focusedlayout>
				<itemlayout width="1412" height="196">
					<include content="KorieListRow"><param name="focus">false</param></include>
				</itemlayout>
				<focusedlayout width="1412" height="196">
					<include content="KorieListRow"><param name="focus">Control.HasFocus(51)</param></include>
				</focusedlayout>
			</control>

			<!-- 54: Android apps, as tiles -->
			<control type="panel" id="54">
				<left>432</left><top>140</top><width>1460</width><height>800</height>
				<onleft>$VAR[KorieToMenu]</onleft>
				<onup>SetFocus(600,$INFO[Container.Property(korie.tabon)],absolute)</onup>
				<orientation>vertical</orientation>
				<scrolltime tween="cubic" easing="out">220</scrolltime>
				<visible>String.IsEqual(Container.Property(korie.section),apps)</visible>
				<itemlayout width="287" height="194"><include content="KorieAppTile"><param name="focus">false</param></include></itemlayout>
				<focusedlayout width="287" height="194"><include content="KorieAppTile"><param name="focus">Control.HasFocus(54)</param></include></focusedlayout>
			</control>

			<!-- 55: add-ons and themes (the Store), as tiles -->
			<control type="panel" id="55">
				<left>432</left><top>140</top><width>1460</width><height>800</height>
				<onleft>$VAR[KorieToMenu]</onleft>
				<onup>SetFocus(600,$INFO[Container.Property(korie.tabon)],absolute)</onup>
				<orientation>vertical</orientation>
				<scrolltime tween="cubic" easing="out">220</scrolltime>
				<visible>String.IsEqual(Container.Property(korie.section),addons)</visible>
				<itemlayout width="479" height="280"><include content="KorieStoreTile"><param name="focus">false</param></include></itemlayout>
				<focusedlayout width="479" height="280"><include content="KorieStoreTile"><param name="focus">Control.HasFocus(55)</param></include></focusedlayout>
			</control>
		</control>

		<!-- tabs at the top (Music: Albums, Artists, Songs; Add-ons: yours, the Store, themes...), from the add-on -->
		<control type="list" id="600">
			<left>444</left><top>146</top><width>1412</width><height>60</height>
			<animation effect="slide" start="0,0" end="336,0" time="0" condition="!String.IsEmpty(Container.Property(korie.series))">Conditional</animation>
			<orientation>horizontal</orientation>
			<onleft condition="String.IsEmpty(Container.Property(korie.series))">$VAR[KorieToMenu]</onleft>
			<onleft condition="!String.IsEmpty(Container.Property(korie.series))">610</onleft>
			<ondown>5100</ondown>
			<onup>9000</onup>
			<scrolltime>0</scrolltime>
			<visible>!String.IsEmpty(Container.Property(korie.tab1.label))</visible>
			<itemlayout width="210" height="56"><include content="KorieChip"><param name="focus">false</param><param name="width">196</param></include></itemlayout>
			<focusedlayout width="210" height="56"><include content="KorieChip"><param name="focus">Control.HasFocus(600)</param><param name="width">196</param></include></focusedlayout>
			<content>
				<include content="KorieTab"><param name="n">1</param></include>
				<include content="KorieTab"><param name="n">2</param></include>
				<include content="KorieTab"><param name="n">3</param></include>
				<include content="KorieTab"><param name="n">4</param></include>
				<include content="KorieTab"><param name="n">5</param></include>
				<include content="KorieTab"><param name="n">6</param></include>
				<include content="KorieTab"><param name="n">7</param></include>
				<include content="KorieTab"><param name="n">8</param></include>
			</content>
		</control>

		<!-- what's playing (music): OK opens Now playing -->
		<control type="group">
			<left>380</left><top>956</top><width>1540</width><height>124</height>
			<visible>Player.HasAudio</visible>
			<control type="image">
				<width>1540</width><height>124</height>
				<texture colordiffuse="korie_shade90">colors/white.png</texture>
			</control>
			<control type="button" id="700">
				<left>40</left><top>10</top><width>1470</width><height>104</height>
				<onup>5100</onup>
				<onleft>$VAR[KorieToMenu]</onleft>
				<texturefocus border="14" colordiffuse="korie_panel">korie/r12.png</texturefocus>
				<texturenofocus />
				<label />
				<onclick>ActivateWindow(visualisation)</onclick>
			</control>
			<control type="image">
				<left>64</left><top>22</top><width>80</width><height>80</height>
				<aspectratio>scale</aspectratio>
				<texture diffuse="korie/mask-square.png">$INFO[MusicPlayer.Cover]</texture>
			</control>
			<control type="label">
				<left>168</left><top>24</top><width>520</width><height>40</height>
				<font>korie_heading30</font><textcolor>korie_ink</textcolor>
				<label>$INFO[MusicPlayer.Title]</label>
			</control>
			<control type="label">
				<left>168</left><top>64</top><width>520</width><height>36</height>
				<font>korie_body24</font><textcolor>korie_soft</textcolor>
				<label>$INFO[MusicPlayer.Artist]$INFO[MusicPlayer.Album, · ]</label>
			</control>
			<control type="label">
				<left>700</left><top>22</top><width>100</width><height>80</height>
				<align>right</align><aligny>center</aligny>
				<font>korie_body24</font><textcolor>korie_soft</textcolor>
				<label>$INFO[Player.Time]</label>
			</control>
			<control type="progress">
				<left>820</left><top>59</top><width>520</width><height>6</height>
				<info>Player.Progress</info>
				<texturebg border="3" colordiffuse="korie_ink25">korie/r10.png</texturebg>
				<midtexture border="3" colordiffuse="korie_accent">korie/r10.png</midtexture>
			</control>
			<control type="label">
				<left>1360</left><top>22</top><width>100</width><height>80</height>
				<aligny>center</aligny>
				<font>korie_body24</font><textcolor>korie_soft</textcolor>
				<label>$INFO[Player.Duration]</label>
			</control>
			<control type="image">
				<left>1460</left><top>46</top><width>32</width><height>32</height>
				<texture colordiffuse="korie_ink">$VAR[KoriePlayPauseIcon]</texture>
			</control>
		</control>

		<!-- the focused film or series, under the grid -->
		<control type="group">
			<left>380</left><top>956</top><width>1540</width><height>124</height>
			<visible>Control.IsVisible(50) + Integer.IsGreater(Container.NumItems,0) + !Player.HasAudio</visible>
			<control type="image">
				<texture colordiffuse="korie_shade90">colors/white.png</texture>
			</control>
			<control type="image">
				<height>1</height>
				<texture colordiffuse="korie_ink15">colors/white.png</texture>
			</control>
			<control type="grouplist">
				<left>64</left><top>0</top><width>1412</width><height>124</height>
				<orientation>horizontal</orientation>
				<itemgap>32</itemgap>
				<align>left</align>
				<control type="label">
					<width>auto</width><height>124</height><aligny>center</aligny>
					<font>korie_heading34</font><textcolor>korie_ink</textcolor>
					<label>$INFO[Container(50).ListItem.Label]</label>
				</control>
				<control type="label">
					<width>auto</width><height>124</height><aligny>center</aligny>
					<font>korie_body24</font><textcolor>korie_dim</textcolor>
					<label>$INFO[Container(50).ListItem.Year]$INFO[Container(50).ListItem.Property(korie.runtime), · ,]$INFO[Container(50).ListItem.Genre, · ]$INFO[Container(50).ListItem.Rating, · , / 10]</label>
				</control>
			</control>
			<control type="label">
				<right>64</right><top>0</top><width>700</width><height>124</height>
				<align>right</align><aligny>center</aligny>
				<font>korie_body22</font><textcolor>korie_dim</textcolor>
				<label>OK: open · Menu: options</label>
			</control>
		</control>
	</controls>
</window>
