<?xml version="1.0" encoding="UTF-8"?>
<!-- Korie: a question or a message that needs an answer (Kodi's: 1 heading, 9 text, 20 progress,
     buttons 11 yes, 10 no, 12 a third choice). -->
<window>
	<depth>DepthDialog+</depth>
	<defaultcontrol always="true">9000</defaultcontrol>
	<controls>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="korie_shade60">colors/white.png</texture>
			<animation effect="fade" start="0" end="100" time="150">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
		</control>
		<control type="group">
			<left>510</left><top>330</top><width>900</width><height>420</height>
			<animation effect="fade" start="0" end="100" time="150">WindowOpen</animation>
			<animation effect="zoom" start="96" end="100" center="auto" time="150" tween="cubic" easing="out">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
			<control type="image">
				<width>900</width><height>420</height>
				<texture border="22" colordiffuse="korie_panel">korie/r28.png</texture>
			</control>
			<control type="label" id="1">
				<left>48</left><top>36</top><width>804</width><height>60</height>
				<aligny>center</aligny>
				<font>korie_heading40</font><textcolor>korie_ink</textcolor>
			</control>
			<control type="textbox" id="9">
				<left>48</left><top>110</top><width>804</width><height>150</height>
				<font>korie_body28</font><textcolor>korie_soft</textcolor>
				<autoscroll time="3000" delay="4000" repeat="5000">true</autoscroll>
			</control>
			<control type="progress" id="20">
				<left>48</left><top>270</top><width>804</width><height>10</height>
				<info>System.Progressbar</info>
				<texturebg border="4" colordiffuse="korie_ink25">korie/r10.png</texturebg>
				<midtexture border="4" colordiffuse="korie_accent">korie/r10.png</midtexture>
			</control>
			<control type="grouplist" id="9000">
				<left>48</left><top>300</top><width>804</width><height>84</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<itemgap>20</itemgap>
				<onup>noop</onup><ondown>noop</ondown>
				<control type="button" id="11">
					<width>250</width><height>84</height>
					<include>KorieDialogButton</include>
				</control>
				<control type="button" id="10">
					<width>250</width><height>84</height>
					<include>KorieDialogButton</include>
				</control>
				<control type="button" id="12">
					<width>250</width><height>84</height>
					<include>KorieDialogButton</include>
				</control>
			</control>
		</control>
	</controls>
</window>
