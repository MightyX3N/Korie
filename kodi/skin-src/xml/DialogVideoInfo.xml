<?xml version="1.0" encoding="UTF-8"?>
<!-- Korie: a film's (or episode's) page: picture, what it is, Resume / Play from the start,
     the story, the cast. Kodi's own controls: 9 resume, 8 play, 50 cast. -->
<window>
	<defaultcontrol always="true">100</defaultcontrol>
	<controls>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="korie_ground">colors/white.png</texture>
		</control>
		<control type="image">
			<left>560</left><top>0</top><width>1360</width><height>765</height>
			<aspectratio>scale</aspectratio>
			<colordiffuse>B3FFFFFF</colordiffuse>
			<texture background="true">$INFO[ListItem.Art(fanart)]</texture>
		</control>
		<control type="image">
			<left>560</left><top>0</top><width>900</width><height>1080</height>
			<texture colordiffuse="korie_ground">korie/fade-left.png</texture>
		</control>
		<control type="image">
			<left>560</left><top>300</top><width>1360</width><height>780</height>
			<texture colordiffuse="korie_ground" flipy="true">korie/fade-up.png</texture>
		</control>

		<!-- back, and the clock -->
		<control type="group">
			<left>96</left><top>52</top>
			<control type="image">
				<left>0</left><top>16</top><width>28</width><height>28</height>
				<texture colordiffuse="korie_soft">korie/icon-back.png</texture>
			</control>
			<control type="label">
				<left>40</left><top>0</top><width>600</width><height>60</height>
				<aligny>center</aligny>
				<font>korie_body26</font><textcolor>korie_soft</textcolor>
				<label>$VAR[KorieInfoBack]</label>
			</control>
		</control>
		<control type="label">
			<right>96</right><top>44</top><width>300</width><height>60</height>
			<align>right</align><aligny>center</aligny>
			<font>korie_heading40</font><textcolor>korie_ink</textcolor>
			<label>$INFO[System.Time]</label>
		</control>

		<control type="group">
			<left>96</left><top>200</top>
			<control type="label">
				<width>1400</width><height>100</height>
				<font>korie_heading72</font><textcolor>korie_ink</textcolor>
				<label>$INFO[ListItem.Title]</label>
			</control>
			<control type="label">
				<top>104</top><width>1400</width><height>40</height>
				<font>korie_body28</font><textcolor>korie_soft</textcolor>
				<label>$VAR[KorieInfoMeta]</label>
			</control>
			<control type="label">
				<top>148</top><width>1400</width><height>36</height>
				<font>korie_body24</font><textcolor>korie_dim</textcolor>
				<label>$INFO[ListItem.Director,Directed by ]</label>
			</control>

			<!-- Resume / Play from the start -->
			<control type="grouplist" id="100">
				<top>222</top><width>1400</width><height>84</height>
				<orientation>horizontal</orientation>
				<itemgap>20</itemgap>
				<ondown>noop</ondown>
				<control type="button" id="109">
					<width>460</width><height>84</height>
					<align>center</align><aligny>center</aligny>
					<font>korie_body28</font>
					<textcolor>korie_ink</textcolor>
					<focusedcolor>korie_onaccent</focusedcolor>
					<texturefocus border="42,0,42,0" colordiffuse="korie_accent">korie/pill84.png</texturefocus>
					<texturenofocus border="42,0,42,0" colordiffuse="korie_panel">korie/pill84.png</texturenofocus>
					<!-- always the first button, so focus starts here: Resume when there's somewhere to
					     resume from (Kodi only knows a moment after the page opens), else Play -->
					<label>$VAR[KorieFirstButton]</label>
					<onclick condition="ListItem.IsResumable">SendClick(9)</onclick>
					<onclick condition="!ListItem.IsResumable">SendClick(8)</onclick>
				</control>
				<control type="button" id="108">
					<width>380</width><height>84</height>
					<align>center</align><aligny>center</aligny>
					<font>korie_body28</font>
					<textcolor>korie_ink</textcolor>
					<focusedcolor>korie_onaccent</focusedcolor>
					<texturefocus border="42,0,42,0" colordiffuse="korie_accent">korie/pill84.png</texturefocus>
					<texturenofocus border="42,0,42,0" colordiffuse="korie_panel">korie/pill84.png</texturenofocus>
					<label>$VAR[KoriePlayLabel]</label>
					<onclick>SendClick(8)</onclick>
					<visible>ListItem.IsResumable</visible>
				</control>
				<control type="label">
					<width>auto</width><height>84</height>
					<aligny>center</aligny>
					<font>korie_body24</font><textcolor>korie_dim</textcolor>
					<label>$INFO[ListItem.Property(korie.left)]</label>
					<visible>ListItem.IsResumable</visible>
				</control>
				<!-- more: Korie's options for this film (favourite, watched, which version...) -->
				<control type="button" id="107">
					<width>84</width><height>84</height>
					<texturefocus colordiffuse="korie_accent">korie/more84.png</texturefocus>
					<texturenofocus colordiffuse="korie_ink40">korie/more84.png</texturenofocus>
					<label></label>
					<onclick>RunPlugin(plugin://plugin.video.korie/?a=options)</onclick>
					<visible>!String.IsEmpty(ListItem.Property(korie.id))</visible>
				</control>
			</control>

			<control type="textbox">
				<top>340</top><width>1080</width><height>210</height>
				<font>korie_body28</font><textcolor>korie_soft</textcolor>
				<label>$INFO[ListItem.Plot]</label>
				<autoscroll delay="8000" time="2500" repeat="8000">true</autoscroll>
			</control>
			<control type="label">
				<top>566</top><width>1400</width><height>34</height>
				<font>korie_body22</font><textcolor>korie_dim</textcolor>
				<label>$INFO[ListItem.VideoResolution,,p]$INFO[ListItem.VideoCodec, · ]$INFO[ListItem.AudioLanguage,  ·  Audio: ]$INFO[ListItem.AudioChannels, ,ch]$INFO[ListItem.SubtitleLanguage,  ·  Subtitles: ]</label>
			</control>
		</control>

		<!-- Kodi's own Resume (9) and Play (8): the buttons above press them. Kodi turns 9 on only
		     after it has picked what to focus, so focus would land on Play; these stay hidden. -->
		<control type="button" id="9"><visible>false</visible></control>
		<control type="button" id="8"><visible>false</visible></control>

		<!-- the cast (Kodi fills list 50) -->
		<control type="label">
			<left>96</left><top>812</top><width>600</width><height>40</height>
			<font>korie_heading30</font><textcolor>korie_soft</textcolor>
			<label>Cast</label>
			<visible>Integer.IsGreater(Container(50).NumItems,0)</visible>
		</control>
		<!-- shown, not chosen: OK on a cast member makes Kodi search its own library for them,
		     which has nothing from Korie ("No results found") -->
		<control type="list" id="50">
			<left>96</left><top>862</top><width>1728</width><height>180</height>
			<orientation>horizontal</orientation>
			<enable>false</enable>
			<onup>100</onup>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<itemlayout width="300" height="180">
				<include content="KorieCastCard"><param name="focus">false</param></include>
			</itemlayout>
			<focusedlayout width="300" height="180">
				<include content="KorieCastCard"><param name="focus">Control.HasFocus(50)</param></include>
			</focusedlayout>
		</control>
	</controls>
</window>
