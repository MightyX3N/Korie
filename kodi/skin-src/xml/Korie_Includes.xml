<?xml version="1.0" encoding="UTF-8"?>
<!-- Korie: the parts every Korie screen shares. Colours are korie_* (from the theme), fonts
     korie_body<size> and korie_heading<size> (from the theme too). -->
<includes>
	<constant name="KorieRail">380</constant>

	<!-- the address of the Korie add-on, so screens can ask it for content -->
	<constant name="KoriePlugin">plugin://plugin.video.korie/</constant>

	<include name="KorieBackground">
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="korie_ground">colors/white.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<aspectratio>scale</aspectratio>
			<texture background="true">$INFO[Skin.String(korie.background)]</texture>
			<visible>!String.IsEmpty(Skin.String(korie.background))</visible>
		</control>
	</include>

	<!-- a picture from the focused thing behind a screen, faded into the ground on the left and bottom -->
	<include name="KorieBackdrop">
		<param name="art">$INFO[ListItem.Art(fanart)]</param>
		<definition>
			<control type="image">
				<left>380</left><top>0</top><width>1540</width><height>866</height>
				<aspectratio>scale</aspectratio>
				<fadetime>300</fadetime>
				<colordiffuse>8CFFFFFF</colordiffuse>
				<texture background="true">$PARAM[art]</texture>
			</control>
			<control type="image">
				<left>380</left><top>0</top><width>900</width><height>1080</height>
				<texture colordiffuse="korie_ground">korie/fade-left.png</texture>
			</control>
			<control type="image">
				<left>380</left><top>420</top><width>1540</width><height>660</height>
				<texture colordiffuse="korie_ground" flipy="true">korie/fade-up.png</texture>
			</control>
		</definition>
	</include>

	<!-- the clock, top right; with date="true" the date sits before it (they share one row, so a
	     wider theme font pushes the date along instead of over the clock) -->
	<include name="KorieClock">
		<param name="date">false</param>
		<definition>
			<control type="grouplist">
				<right>64</right><top>44</top><width>900</width><height>60</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<itemgap>18</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="label">
					<top>6</top><width>auto</width><height>60</height>
					<aligny>center</aligny>
					<font>korie_body26</font><textcolor>korie_dim</textcolor>
					<label>$INFO[System.Date(DDDD d mmmm)]</label>
					<visible>$PARAM[date]</visible>
				</control>
				<control type="label">
					<width>auto</width><height>60</height>
					<aligny>center</aligny>
					<font>korie_heading40</font>
					<textcolor>korie_ink</textcolor>
					<label>$INFO[System.Time]</label>
				</control>
			</control>
		</definition>
	</include>

	<include name="KorieLogo">
		<param name="left">64</param>
		<definition>
			<control type="group">
				<left>$PARAM[left]</left><top>52</top>
				<control type="image">
					<left>0</left><top>21</top><width>18</width><height>18</height>
					<texture border="4" colordiffuse="korie_accent">korie/r10.png</texture>
				</control>
				<control type="label">
					<left>32</left><top>0</top><width>300</width><height>60</height>
					<aligny>center</aligny>
					<font>korie_heading46</font>
					<textcolor>korie_ink</textcolor>
					<label>korie</label>
				</control>
			</control>
		</definition>
	</include>

	<!-- A screen's title, and the clock, to the right of the menu -->
	<include name="KorieHeader">
		<param name="title"></param>
		<param name="note"></param>
		<param name="date">false</param>
		<definition>
			<control type="grouplist">
				<left>444</left><top>48</top><width>1100</width><height>64</height>
				<orientation>horizontal</orientation>
				<itemgap>18</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="label">
					<width>auto</width><height>64</height>
					<aligny>center</aligny>
					<font>korie_heading46</font>
					<textcolor>korie_ink</textcolor>
					<label>$PARAM[title]</label>
				</control>
				<control type="label">
					<top>6</top><width>auto</width><height>64</height>
					<aligny>center</aligny>
					<font>korie_body26</font>
					<textcolor>korie_dim</textcolor>
					<label>$PARAM[note]</label>
				</control>
			</control>
			<include content="KorieClock"><param name="date">$PARAM[date]</param></include>
		</definition>
	</include>

	<!-- The menu on the left of every screen. "active" is the id of the screen it's on;
	     "right" is what the remote's right button goes to. -->
	<include name="KorieRailItem">
		<param name="id"/>
		<param name="label"/>
		<param name="icon"/>
		<param name="action"/>
		<param name="n"/>
		<definition>
			<item>
				<label>$PARAM[label]</label>
				<icon>korie/icon-$PARAM[icon].png</icon>
				<property name="id">$PARAM[id]</property>
				<property name="here">$INFO[Window(Home).Property(korie.here.$PARAM[id])]</property>
				<onclick>ClearProperty(korie.here.home,home)</onclick>
				<onclick>ClearProperty(korie.here.films,home)</onclick>
				<onclick>ClearProperty(korie.here.series,home)</onclick>
				<onclick>ClearProperty(korie.here.live,home)</onclick>
				<onclick>ClearProperty(korie.here.addons,home)</onclick>
				<onclick>ClearProperty(korie.here.search,home)</onclick>
				<onclick>ClearProperty(korie.here.settings,home)</onclick>
				<onclick>SetProperty(korie.here.$PARAM[id],1,home)</onclick>
				<onclick>SetProperty(korie.here.n,$PARAM[n],home)</onclick>
				<onclick>$PARAM[action]</onclick>
			</item>
		</definition>
	</include>

	<!-- marks which menu entry the screen belongs to (Home and Settings do it when they open) -->
	<include name="KorieHere">
		<param name="id"/>
		<param name="n"/>
		<definition>
			<onload>ClearProperty(korie.here.home,home)</onload>
			<onload>ClearProperty(korie.here.films,home)</onload>
			<onload>ClearProperty(korie.here.series,home)</onload>
			<onload>ClearProperty(korie.here.live,home)</onload>
			<onload>ClearProperty(korie.here.addons,home)</onload>
			<onload>ClearProperty(korie.here.search,home)</onload>
			<onload>ClearProperty(korie.here.settings,home)</onload>
			<onload>SetProperty(korie.here.$PARAM[id],1,home)</onload>
			<onload>SetProperty(korie.here.n,$PARAM[n],home)</onload>
		</definition>
	</include>

	<include name="KorieRail">
		<param name="right">5000</param>
		<definition>
			<control type="group">
				<left>0</left><top>0</top><width>380</width><height>1080</height>
				<control type="image">
					<left>0</left><top>0</top><width>380</width><height>1080</height>
					<texture colordiffuse="korie_shade90">colors/white.png</texture>
				</control>
				<control type="image">
					<left>379</left><top>0</top><width>1</width><height>1080</height>
					<texture colordiffuse="korie_ink15">colors/white.png</texture>
				</control>
				<include content="KorieLogo"><param name="left">44</param></include>
				<control type="list" id="9000">
					<left>20</left><top>152</top><width>340</width><height>680</height>
					<orientation>vertical</orientation>
					<onright>$PARAM[right]</onright>
					<ondown>9100</ondown>
					<scrolltime>0</scrolltime>
					<itemlayout width="340" height="72">
						<control type="image">
							<left>0</left><top>2</top><width>340</width><height>68</height>
							<texture border="14" colordiffuse="korie_accent25">korie/r12.png</texture>
							<visible>!String.IsEmpty(ListItem.Property(here))</visible>
						</control>
						<control type="image">
							<left>0</left><top>2</top><width>5</width><height>68</height>
							<texture colordiffuse="korie_accent">colors/white.png</texture>
							<visible>!String.IsEmpty(ListItem.Property(here))</visible>
						</control>
						<control type="image">
							<left>24</left><top>20</top><width>32</width><height>32</height>
							<texture colordiffuse="korie_soft">$INFO[ListItem.Icon]</texture>
						</control>
						<control type="label">
							<left>78</left><top>2</top><width>250</width><height>68</height>
							<aligny>center</aligny>
							<font>korie_heading34</font>
							<textcolor>korie_soft</textcolor>
							<label>$INFO[ListItem.Label]</label>
						</control>
					</itemlayout>
					<focusedlayout width="340" height="72">
						<control type="image">
							<left>0</left><top>2</top><width>340</width><height>68</height>
							<texture border="14" colordiffuse="korie_accent">korie/r12.png</texture>
							<visible>Control.HasFocus(9000)</visible>
						</control>
						<control type="image">
							<left>0</left><top>2</top><width>340</width><height>68</height>
							<texture border="14" colordiffuse="korie_accent25">korie/r12.png</texture>
							<visible>!Control.HasFocus(9000) + !String.IsEmpty(ListItem.Property(here))</visible>
						</control>
						<control type="image">
							<left>0</left><top>2</top><width>5</width><height>68</height>
							<texture colordiffuse="korie_accent">colors/white.png</texture>
							<visible>!Control.HasFocus(9000) + !String.IsEmpty(ListItem.Property(here))</visible>
						</control>
						<control type="image">
							<left>24</left><top>20</top><width>32</width><height>32</height>
							<texture colordiffuse="korie_onaccent">$INFO[ListItem.Icon]</texture>
							<visible>Control.HasFocus(9000)</visible>
						</control>
						<control type="image">
							<left>24</left><top>20</top><width>32</width><height>32</height>
							<texture colordiffuse="korie_soft">$INFO[ListItem.Icon]</texture>
							<visible>!Control.HasFocus(9000)</visible>
						</control>
						<control type="label">
							<left>78</left><top>2</top><width>250</width><height>68</height>
							<aligny>center</aligny>
							<font>korie_heading34</font>
							<textcolor>korie_onaccent</textcolor>
							<label>$INFO[ListItem.Label]</label>
							<visible>Control.HasFocus(9000)</visible>
						</control>
						<control type="label">
							<left>78</left><top>2</top><width>250</width><height>68</height>
							<aligny>center</aligny>
							<font>korie_heading34</font>
							<textcolor>korie_soft</textcolor>
							<label>$INFO[ListItem.Label]</label>
							<visible>!Control.HasFocus(9000)</visible>
						</control>
					</focusedlayout>
					<content>
						<include content="KorieRailItem"><param name="id">home</param><param name="n">0</param><param name="label">Home</param><param name="icon">home</param>
							<param name="action">ReplaceWindow(Home)</param></include>
						<include content="KorieRailItem"><param name="id">films</param><param name="n">1</param><param name="label">Films</param><param name="icon">films</param>
							<param name="action">ReplaceWindow(Videos,plugin://plugin.video.korie/?a=films,return)</param></include>
						<include content="KorieRailItem"><param name="id">series</param><param name="n">2</param><param name="label">Series</param><param name="icon">series</param>
							<param name="action">ReplaceWindow(Videos,plugin://plugin.video.korie/?a=series,return)</param></include>
						<include content="KorieRailItem"><param name="id">live</param><param name="n">3</param><param name="label">Live TV</param><param name="icon">live</param>
							<param name="action">ReplaceWindow(Videos,plugin://plugin.video.korie/?a=live,return)</param></include>
						<include content="KorieRailItem"><param name="id">addons</param><param name="n">4</param><param name="label">Add-ons</param><param name="icon">addons</param>
							<param name="action">ReplaceWindow(Videos,plugin://plugin.video.korie/?a=addons,return)</param></include>
						<include content="KorieRailItem"><param name="id">search</param><param name="n">5</param><param name="label">Search</param><param name="icon">search</param>
							<param name="action">ReplaceWindow(Videos,plugin://plugin.video.korie/?a=search,return)</param></include>
						<include content="KorieRailItem"><param name="id">settings</param><param name="n">6</param><param name="label">Settings</param><param name="icon">settings</param>
							<param name="action">ReplaceWindow(1191)</param></include>
					</content>
				</control>
				<!-- who's watching, and switching -->
				<control type="button" id="9100">
					<left>32</left><top>960</top><width>316</width><height>80</height>
					<onup>9000</onup>
					<onright>$PARAM[right]</onright>
					<texturefocus border="14" colordiffuse="korie_accent">korie/r12.png</texturefocus>
					<texturenofocus />
					<label />
					<onclick>ActivateWindow(1190)</onclick>
				</control>
				<control type="image">
					<left>46</left><top>974</top><width>52</width><height>52</height>
					<texture colordiffuse="$INFO[Window(Home).Property(korie.person.colour)]">korie/pill.png</texture>
				</control>
				<control type="label">
					<left>46</left><top>974</top><width>52</width><height>52</height>
					<align>center</align><aligny>center</aligny>
					<font>korie_heading26</font>
					<textcolor>korie_ground</textcolor>
					<label>$INFO[Window(Home).Property(korie.person.letter)]</label>
				</control>
				<control type="label">
					<left>114</left><top>970</top><width>230</width><height>34</height>
					<font>korie_body26</font>
					<textcolor>korie_ink</textcolor>
					<label>$INFO[Window(Home).Property(korie.person.name)]</label>
				</control>
				<control type="label">
					<left>114</left><top>1002</top><width>230</width><height>30</height>
					<font>korie_body20</font>
					<textcolor>korie_dim</textcolor>
					<label>Switch person</label>
				</control>
			</control>
		</definition>
	</include>

	<!-- into the menu, on the entry of the screen you're on -->
	<variable name="KorieToMenu">
		<value condition="!String.IsEmpty(Window(Home).Property(korie.here.n))">SetFocus(9000,$INFO[Window(Home).Property(korie.here.n)],absolute)</value>
		<value>SetFocus(9000)</value>
	</variable>

	<!-- Cards for the rows: a poster, a wide picture or a square one, with the progress line -->
	<include name="KorieProgress">
		<param name="width"/>
		<param name="top"/>
		<definition>
			<control type="progress">
				<left>0</left><top>$PARAM[top]</top><width>$PARAM[width]</width><height>7</height>
				<texturebg colordiffuse="korie_ink40">colors/white.png</texturebg>
				<midtexture colordiffuse="korie_accent">colors/white.png</midtexture>
				<info>ListItem.PercentPlayed</info>
				<visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
			</control>
		</definition>
	</include>

	<include name="KorieWatched">
		<param name="right">10</param>
		<definition>
			<control type="group">
				<right>$PARAM[right]</right><top>10</top><width>34</width><height>34</height>
				<visible>ListItem.IsPlayable + Integer.IsGreater(ListItem.PlayCount,0)</visible>
				<control type="image">
					<texture colordiffuse="korie_shade90">korie/pill.png</texture>
				</control>
				<control type="image">
					<left>7</left><top>7</top><width>20</width><height>20</height>
					<texture colordiffuse="korie_accent">korie/icon-check.png</texture>
				</control>
			</control>
		</definition>
	</include>

	<!-- what a card looks like; "focus" true draws the focus ring -->
	<include name="KorieCardPoster">
		<param name="focus">false</param>
		<definition>
			<control type="image">
				<left>-9</left><top>-9</top><width>190</width><height>288</height>
				<texture border="16" colordiffuse="korie_accent">korie/r16.png</texture>
				<visible>$PARAM[focus]</visible>
			</control>
			<control type="image">
				<left>-4</left><top>-4</top><width>180</width><height>278</height>
				<texture border="14" colordiffuse="korie_ground">korie/r12.png</texture>
				<visible>$PARAM[focus]</visible>
			</control>
			<control type="image">
				<width>172</width><height>258</height>
				<texture border="12" colordiffuse="korie_panel">korie/r10.png</texture>
			</control>
			<control type="label">
				<left>12</left><width>148</width><height>258</height>
				<align>center</align><aligny>center</aligny><wrapmultiline>true</wrapmultiline>
				<font>korie_body22</font><textcolor>korie_dim</textcolor>
				<label>$INFO[ListItem.Label]</label>
				<visible>String.IsEmpty(ListItem.Art(poster)) + String.IsEmpty(ListItem.Art(thumb))</visible>
			</control>
			<control type="image">
				<width>172</width><height>258</height>
				<aspectratio>scale</aspectratio>
				<texture diffuse="korie/mask-poster.png" background="true">$VAR[KoriePoster]</texture>
			</control>
			<include content="KorieWatched"/>
			<include content="KorieProgress"><param name="width">172</param><param name="top">251</param></include>
		</definition>
	</include>

	<variable name="KoriePoster">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>
	<variable name="KorieWide">
		<value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Art(fanart)]</value>
	</variable>
	<variable name="KorieSquare">
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Art(poster)]</value>
	</variable>

	<!-- the line under a card: time left, or the season and episode, or the year -->
	<variable name="KorieCardNote">
		<value condition="Integer.IsGreater(ListItem.PercentPlayed,0) + !String.IsEmpty(ListItem.Duration)">$INFO[ListItem.Property(korie.left)]</value>
		<value condition="!String.IsEmpty(ListItem.Property(korie.subtitle))">$INFO[ListItem.Property(korie.subtitle)]</value>
		<value>$INFO[ListItem.Year]</value>
	</variable>

	<include name="KorieCardWide">
		<param name="focus">false</param>
		<definition>
			<control type="image">
				<left>-9</left><top>-9</top><width>438</width><height>254</height>
				<texture border="18" colordiffuse="korie_accent">korie/r18.png</texture>
				<visible>$PARAM[focus]</visible>
			</control>
			<control type="image">
				<left>-4</left><top>-4</top><width>428</width><height>244</height>
				<texture border="16" colordiffuse="korie_ground">korie/r16.png</texture>
				<visible>$PARAM[focus]</visible>
			</control>
			<control type="image">
				<width>420</width><height>236</height>
				<texture border="12" colordiffuse="korie_panel">korie/r12.png</texture>
			</control>
			<control type="image">
				<width>420</width><height>236</height>
				<aspectratio>scale</aspectratio>
				<texture diffuse="korie/mask-wide.png" background="true">$VAR[KorieWide]</texture>
			</control>
			<include content="KorieProgress"><param name="width">420</param><param name="top">229</param></include>
			<control type="label">
				<top>248</top><width>420</width><height>34</height>
				<font>korie_body26</font><textcolor>korie_ink</textcolor>
				<label>$INFO[ListItem.Label]</label>
			</control>
			<control type="label">
				<top>282</top><width>420</width><height>30</height>
				<font>korie_body22</font><textcolor>korie_dim</textcolor>
				<label>$VAR[KorieCardNote]</label>
			</control>
		</definition>
	</include>

	<include name="KorieCardSquare">
		<param name="focus">false</param>
		<definition>
			<control type="image">
				<left>-9</left><top>-9</top><width>238</width><height>238</height>
				<texture border="18" colordiffuse="korie_accent">korie/r18.png</texture>
				<visible>$PARAM[focus]</visible>
			</control>
			<control type="image">
				<left>-4</left><top>-4</top><width>228</width><height>228</height>
				<texture border="16" colordiffuse="korie_ground">korie/r16.png</texture>
				<visible>$PARAM[focus]</visible>
			</control>
			<control type="image">
				<width>220</width><height>220</height>
				<texture border="12" colordiffuse="korie_panel">korie/r12.png</texture>
			</control>
			<control type="image">
				<width>220</width><height>220</height>
				<aspectratio>scale</aspectratio>
				<texture diffuse="korie/mask-square.png" background="true">$VAR[KorieSquare]</texture>
			</control>
			<control type="label">
				<top>232</top><width>220</width><height>32</height>
				<font>korie_body24</font><textcolor>korie_ink</textcolor>
				<label>$INFO[ListItem.Label]</label>
			</control>
		</definition>
	</include>

	<!-- A row on Home: n is its number; the Korie add-on puts each row's title and kind
	     (poster, wide, square) in Window(Home) properties, and the row's list only appears for its kind -->
	<include name="KorieHomeRow">
		<param name="n"/>
		<definition>
			<control type="label">
				<width>1476</width><height>48</height>
				<aligny>center</aligny>
				<font>korie_heading30</font><textcolor>korie_soft</textcolor>
				<label>$INFO[Window(Home).Property(korie.row.$PARAM[n].title)]</label>
				<visible>!String.IsEmpty(Window(Home).Property(korie.row.$PARAM[n].title))</visible>
			</control>
			<control type="list" id="5$PARAM[n]1">
				<width>1476</width><height>330</height>
				<orientation>horizontal</orientation>
				<onleft>$VAR[KorieToMenu]</onleft>
				<scrolltime tween="cubic" easing="out">220</scrolltime>
				<focusposition>0</focusposition>
				<movement>2</movement>
				<visible>String.IsEqual(Window(Home).Property(korie.row.$PARAM[n].kind),wide)</visible>
				<itemlayout width="448" height="330"><include content="KorieCardWide"/></itemlayout>
