<?xml version="1.0" encoding="UTF-8"?>
<!-- Korie: Home. The menu on the left, then the rows the Korie server puts on Home
     (continue watching, recently added, add-ons' rows ...), up to eight. -->
<window>
	<defaultcontrol always="true">5000</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<onload condition="String.IsEmpty(Window(Home).Property(korie.person.name))">ReplaceWindow(1190)</onload>
	<onload>NotifyAll(plugin.video.korie,home)</onload>
	<include content="KorieHere"><param name="id">home</param><param name="n">0</param></include>
	<controls>
		<include>KorieBackground</include>
		<control type="group">
			<visible>Control.HasFocus(5000) | ControlGroup(5000).HasFocus()</visible>
			<include content="KorieBackdrop"><param name="art">$INFO[Container.ListItem.Art(fanart)]</param></include>
		</control>
		<include content="KorieRail"><param name="right">5000</param></include>
		<include content="KorieHeader">
			<param name="title">Home</param>
			<param name="date">true</param>
		</include>

		<!-- nothing yet: the server's own message (no libraries, still scanning ...) -->
		<control type="label">
			<left>444</left><top>200</top><width>1300</width><height>200</height>
			<font>korie_body28</font><textcolor>korie_dim</textcolor>
			<wrapmultiline>true</wrapmultiline>
			<label>$INFO[Window(Home).Property(korie.status)]</label>
			<visible>String.IsEqual(Window(Home).Property(korie.rows),0)</visible>
		</control>

		<control type="grouplist" id="5000">
			<left>432</left><top>128</top><width>1488</width><height>952</height>
			<orientation>vertical</orientation>
			<itemgap>14</itemgap>
			<onleft>$VAR[KorieToMenu]</onleft>
			<scrolltime tween="cubic" easing="out">260</scrolltime>
			<include content="KorieHomeRow"><param name="n">1</param></include>
			<include content="KorieHomeRow"><param name="n">2</param></include>
			<include content="KorieHomeRow"><param name="n">3</param></include>
			<include content="KorieHomeRow"><param name="n">4</param></include>
			<include content="KorieHomeRow"><param name="n">5</param></include>
			<include content="KorieHomeRow"><param name="n">6</param></include>
			<include content="KorieHomeRow"><param name="n">7</param></include>
			<include content="KorieHomeRow"><param name="n">8</param></include>
			<control type="label">
				<width>1400</width><height>40</height>
				<label> </label>
			</control>
		</control>
	</controls>
</window>
