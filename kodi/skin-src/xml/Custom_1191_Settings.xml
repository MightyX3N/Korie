<?xml version="1.0" encoding="UTF-8"?>
<!-- Korie: Settings on this TV. Everything about the library, people and add-ons is set on the
     Korie server; here is only what belongs to this screen. -->
<window type="window" id="1191">
	<defaultcontrol always="true">300</defaultcontrol>
	<include content="KorieHere"><param name="id">settings</param><param name="n">6</param></include>
	<onload>RunPlugin(plugin://plugin.video.korie/?a=settings)</onload>
	<controls>
		<include>KorieBackground</include>
		<include content="KorieRail"><param name="right">300</param></include>
		<include content="KorieHeader"><param name="title">Settings</param></include>
		<control type="list" id="300">
			<left>444</left><top>160</top><width>1100</width><height>800</height>
			<orientation>vertical</orientation>
			<onleft>$VAR[KorieToMenu]</onleft>
			<itemlayout width="1100" height="128">
				<include content="KorieSettingRow"><param name="focus">false</param></include>
			</itemlayout>
			<focusedlayout width="1100" height="128">
				<include content="KorieSettingRow"><param name="focus">Control.HasFocus(300)</param></include>
			</focusedlayout>
			<content>
				<item>
					<label>Theme</label>
					<label2>$INFO[Window(Home).Property(korie.theme.name)]</label2>
					<icon>korie/icon-palette.png</icon>
					<property name="help">How Korie looks on this screen</property>
					<onclick>RunPlugin(plugin://plugin.video.korie/?a=theme)</onclick>
				</item>
				<item>
					<label>Switch person</label>
					<label2>$INFO[Window(Home).Property(korie.person.name)]</label2>
					<icon>korie/icon-person.png</icon>
					<property name="help">Who's watching on this screen</property>
					<onclick>ActivateWindow(1190)</onclick>
				</item>
				<item>
					<label>Korie server</label>
					<label2>$INFO[Window(Home).Property(korie.server)]</label2>
					<icon>korie/icon-server.png</icon>
					<property name="help">Where this screen gets everything from</property>
					<onclick>RunPlugin(plugin://plugin.video.korie/?a=server)</onclick>
				</item>
				<item>
					<label>Check for updates</label>
					<label2>$INFO[System.AddonVersion(plugin.video.korie),Korie ,]</label2>
					<icon>korie/icon-check.png</icon>
					<property name="help">Gets the newest Korie from your server now (it also does this by itself)</property>
					<onclick>UpdateAddonRepos</onclick>
				</item>
				<item>
					<label>About</label>
					<label2>$INFO[System.BuildVersionShort,Kodi ,]</label2>
					<icon>korie/icon-info.png</icon>
					<property name="help">Libraries, people, add-ons and themes are set up on the Korie server's page</property>
				</item>
				<item>
					<label>Kodi's own settings</label>
					<label2></label2>
					<icon>korie/icon-settings.png</icon>
					<property name="help">Only if something needs fixing: Kodi's menus, as they are without Korie</property>
					<onclick>ActivateWindow(settings)</onclick>
				</item>
			</content>
		</control>
	</controls>
</window>
