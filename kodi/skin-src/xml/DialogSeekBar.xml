<?xml version="1.0" encoding="UTF-8"?>
<!-- Korie: what's playing and how far in - shown with the player's controls, while seeking and
     while paused. When it shows is Kodi's (the same as Estuary); the look is Korie's. Kodi moves
     slider 401 while you seek. -->
<window>
	<!-- films only: music has its own Now playing screen (MusicVisualisation.xml) -->
	<visible>Window.IsActive(fullscreenvideo)</visible>
	<visible>![Window.IsActive(sliderdialog) | Window.IsActive(pvrosdchannels) | Window.IsActive(pvrchannelguide) | Window.IsActive(pvrguideinfo) | Window.IsActive(1110)]</visible>
	<visible>Player.Seeking | Player.HasPerformedSeek(3) | [Player.Paused + !Player.Caching] | Player.Forwarding | Player.Rewinding | Player.ShowInfo | Window.IsActive(fullscreeninfo) | Player.ShowTime | Window.IsActive(videoosd) | Window.IsActive(musicosd) | Window.IsActive(playerprocessinfo) | !String.IsEmpty(Player.SeekNumeric)</visible>
	<depth>DepthOSD</depth>
	<zorder>0</zorder>
	<animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
	<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
	<controls>
		<!-- shade at the top and bottom, so the text reads over any picture -->
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>300</height>
			<texture colordiffuse="korie_shade90">korie/fade-up.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>660</top><width>1920</width><height>420</height>
			<texture colordiffuse="korie_shade90" flipy="true">korie/fade-up.png</texture>
		</control>

		<!-- what's playing -->
		<control type="label">
			<left>96</left><top>50</top><width>1400</width><height>64</height>
			<aligny>center</aligny>
			<font>korie_heading46</font><textcolor>korie_ink</textcolor>
			<label>$VAR[KoriePlayerTitle]</label>
		</control>
		<control type="label">
			<left>96</left><top>110</top><width>1400</width><height>40</height>
			<aligny>center</aligny>
			<font>korie_body28</font><textcolor>korie_soft</textcolor>
			<label>$VAR[KoriePlayerNote]</label>
		</control>
		<control type="label">
			<right>96</right><top>48</top><width>300</width><height>64</height>
			<align>right</align><aligny>center</aligny>
			<font>korie_heading46</font><textcolor>korie_ink</textcolor>
			<label>$INFO[System.Time]</label>
		</control>

		<!-- how far in -->
		<control type="group">
			<left>96</left><top>840</top>
			<visible>Player.SeekEnabled + !String.IsEmpty(Player.Duration)</visible>
			<control type="progress">
				<left>0</left><top>11</top><width>1728</width><height>8</height>
				<info>Player.ProgressCache</info>
				<texturebg border="4" colordiffuse="korie_ink25">korie/r10.png</texturebg>
				<midtexture border="4" colordiffuse="korie_ink40">korie/r10.png</midtexture>
			</control>
			<control type="progress">
				<left>0</left><top>11</top><width>1728</width><height>8</height>
				<info>Player.Progress</info>
				<texturebg border="4" colordiffuse="00FFFFFF">korie/r10.png</texturebg>
				<midtexture border="4" colordiffuse="korie_accent">korie/r10.png</midtexture>
			</control>
			<control type="ranges">
				<left>0</left><top>6</top><width>1728</width><height>18</height>
				<texturebg>korie/clear18.png</texturebg>
				<righttexture colordiffuse="korie_ink">korie/tick.png</righttexture>
				<info>Player.Chapters</info>
			</control>
			<control type="slider" id="401">
				<left>-15</left><top>0</top><width>1758</width><height>30</height>
				<texturesliderbar>korie/clear30.png</texturesliderbar>
				<textureslidernib colordiffuse="korie_ink">korie/nub.png</textureslidernib>
				<textureslidernibfocus colordiffuse="korie_ink">korie/nub.png</textureslidernibfocus>
			</control>
			<control type="label">
				<left>0</left><top>34</top><width>600</width><height>40</height>
				<aligny>center</aligny>
				<font>korie_body26</font><textcolor>korie_ink</textcolor>
				<label>$VAR[KoriePlayerTime]</label>
			</control>
			<control type="label">
				<left>1128</left><top>34</top><width>600</width><height>40</height>
				<align>right</align><aligny>center</aligny>
				<font>korie_body26</font><textcolor>korie_soft</textcolor>
				<label>$INFO[Player.Duration]</label>
			</control>
		</control>

		<!-- paused, with no controls on screen: say so in the middle -->
		<control type="group">
			<visible>Player.Paused + !Window.IsActive(videoosd) + !Player.Seeking + !Player.HasPerformedSeek(3)</visible>
			<control type="image">
				<left>900</left><top>480</top><width>120</width><height>120</height>
				<texture colordiffuse="korie_shade60">korie/mask-circle.png</texture>
			</control>
			<control type="image">
				<left>930</left><top>510</top><width>60</width><height>60</height>
				<texture colordiffuse="korie_ink">korie/icon-pause.png</texture>
			</control>
		</control>
	</controls>
</window>
