{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Korie",
  "version": "0.6.0",
  "identifier": "app.korie.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Korie",
    "shortDescription": "Korie media centre",
    "longDescription": "Korie for Windows, Mac and Linux: finds the Korie server on your network and shows it full screen.",
    "category": "Entertainment",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
